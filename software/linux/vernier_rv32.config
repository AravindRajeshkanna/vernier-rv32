# Kernel configuration for the SoC in rtl/soc/soc_top.v.
#
# A fragment, not a defconfig: it is merged over `allnoconfig` by
# software/linux/build-linux.sh, so every line here is something this SoC
# needs and everything absent is off. That direction matters. A defconfig
# for a real board carries hundreds of drivers for hardware that does not
# exist here, and the resulting Image does not fit in 32 MB of SDRAM - let
# alone leave room for the kernel to run in.
#
# Each line is either a device this SoC has or a kernel facility the boot
# path needs. Nothing here is aspirational.

# ---- the ISA this core actually implements ----
#
# rv32ima, and specifically *not* rv32imac. CONFIG_ARCH_RV32I sits behind
# CONFIG_NONPORTABLE because rv32 Linux is not a profile-conforming target;
# that is an accurate description of this machine.
CONFIG_NONPORTABLE=y
CONFIG_ARCH_RV32I=y
CONFIG_MMU=y
CONFIG_CMODEL_MEDANY=y
# CONFIG_RISCV_ISA_C is not set
# CONFIG_FPU is not set
# CONFIG_SMP is not set
# CONFIG_RISCV_ISA_V is not set

# CONFIG_EFI is `default y` on riscv and `select RISCV_ISA_C`. Turning the C
# extension off is therefore not enough on its own: EFI turns it straight
# back on, kconfig reports nothing, and the build emits compressed
# instructions for a core that has none. The first symptom would be an
# illegal-instruction trap before any console exists.
#
# Nothing here boots through UEFI - OpenSBI's fw_jump enters the kernel
# directly - so this is a straightforward loss of a feature we do not use.
# software/linux/kconfig-merge.py's `check` is what caught it.
# CONFIG_EFI is not set

# CONFIG_RISCV_ALTERNATIVE cannot be turned off: `config RISCV` selects it
# unconditionally for a non-XIP kernel. So the alternative *mechanism* stays,
# and what these do instead is stop the extensions being compiled in at all.
# The hart advertises none of them in dts/soc.dts, so nothing would be
# patched in either way; this is image size, not correctness.
#
# It is not the whole story on Zacas. arch/riscv/Makefile appends `_zacas` to
# -march whenever the *toolchain* supports it, keyed on TOOLCHAIN_HAS_ZACAS
# rather than on this option, and that symbol has no prompt to turn off. So
# the assembler will still accept `amocas`, and the compiler is still allowed
# to emit one for an atomic builtin. That is why build-linux.sh disassembles
# the finished kernel and checks it against what rtl/ implements, rather than
# trusting the configuration to have been enough.
# CONFIG_RISCV_ISA_ZACAS is not set
# CONFIG_RISCV_ISA_ZABHA is not set
# CONFIG_RISCV_ISA_ZBB is not set
# CONFIG_RISCV_ISA_ZICBOM is not set
# CONFIG_RISCV_ISA_ZICBOZ is not set

# ---- timekeeping ----
#
# 100 Hz because every tick is a timer interrupt, an SBI call into OpenSBI
# and a write to the CLINT, and under Verilator the whole boot is about
# 3x10^8 cycles. At 25 MHz, 100 Hz is 250,000 cycles per tick.
# HZ is a `choice`, so the default has to be turned off explicitly - setting
# HZ_100 alone leaves HZ_250 set and kconfig keeps the first one.
# CONFIG_HZ_250 is not set
CONFIG_HZ_100=y
CONFIG_HZ=100

# ---- console ----
#
# rtl/uart.v is an ns16550 at 0x0400_0000 with reg-shift 2; dts/soc.dts
# declares it "ns16550a" with reg-io-width 4, which is what makes the 8250
# driver use 32-bit accesses on this word-addressed bus.
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_OF_PLATFORM=y

# The SBI earlycon prints through OpenSBI's console before the 8250 driver
# has probed, which covers the window where a failure is otherwise silent -
# the same window that cost this project a PR to instrument in hardware.
# `earlycon=sbi` in the kernel command line turns it on.
CONFIG_SERIAL_EARLYCON=y
CONFIG_SERIAL_EARLYCON_RISCV_SBI=y

# ---- interrupts ----
#
# rtl/plic.v, two contexts. The driver skips the M-mode context and takes
# the S-mode one, which is why the order in dts/soc.dts is the interface.
CONFIG_SIFIVE_PLIC=y

# ---- userspace ----
CONFIG_BINFMT_ELF=y
CONFIG_PROC_FS=y

# ---- the initramfs ----
#
# Built into the Image rather than loaded beside it. One blob is one
# transfer over software/soc/uartload.py and one address for OpenSBI to
# jump to, and it removes the DT `linux,initrd-start` handoff entirely.
# CONFIG_INITRAMFS_SOURCE is set on the command line by build-linux.sh,
# because it has to be an absolute path into the build directory.
CONFIG_BLK_DEV_INITRD=y

# ---- size ----
#
# Every one of these is a driver subsystem for hardware this SoC does not
# have. allnoconfig turns them off already; they are listed so that a later
# `make menuconfig` that turns one on has to argue with a comment.
# CONFIG_EXPERT is what makes CONFIG_BLOCK a question at all - without it
# the block layer is `default y` with no prompt. There is no block device on
# this SoC and the root filesystem is a cpio archive in the kernel image.
CONFIG_EXPERT=y
# CONFIG_NET is not set
# CONFIG_BLOCK is not set
# CONFIG_SWAP is not set
# CONFIG_MODULES is not set
