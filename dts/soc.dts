/dts-v1/;

/*
 * Device tree for the SoC in rtl/soc/soc_top.v.
 *
 * Build it with `make dtb`, which compiles it and then round-trips the
 * result back to source to confirm it decodes.
 *
 * What this is and isn't: it is an accurate description of the hardware in
 * the standard format that RISC-V firmware (OpenSBI, U-Boot, Linux) expects
 * to be handed. It compiles to dts/soc.dtb, which software/opensbi/mkimage.py
 * packs into every image `make sim_opensbi`/`sim_linux` boot and OpenSBI
 * genuinely parses at runtime - this stopped being aspirational once that
 * integration landed (docs/roadmap.md's OpenSBI phase). The boot ROM and
 * software/soc/main.c's own RAM program still have the memory map compiled
 * in via software/soc/soc.h instead of reading this, since both predate the
 * device tree and have no reason to add a parser for one.
 *
 * Anything here that would need to change before real supervisor software
 * could use it is called out in a comment rather than quietly fudged.
 *
 * Frequencies are 25 MHz, which is what the ULX3S build actually runs at
 * (soc_top.v's CLK_HZ, and fpga/README.md's measured Fmax of 25.37 MHz gives
 * it 1.5% of margin). They used to say 50 MHz, which was a placeholder from
 * before the design had ever been on a board.
 *
 * `timebase-frequency` must match what the CLINT's mtime actually counts at,
 * and in this design mtime increments once per *system clock* (rtl/clint.v, a
 * documented simplification versus a real separate always-on reference
 * clock), so the two are the same number here.
 *
 * The UART's `clock-frequency` is the input to its baud divisor, and 25 MHz
 * does not divide evenly to 115200: a driver computing 25e6/(16*115200) gets
 * 13.56 and will write 14, for 111607 baud - 3.1% slow. That is inside the
 * roughly 5% a UART frame tolerates, but it is a real error rather than zero,
 * and it is the kind of thing that shows up as occasional framing errors on a
 * long cable rather than as an obvious failure.
 */

/ {
    #address-cells = <1>;
    #size-cells = <1>;
    compatible = "riscv-fpga-cpu,soc";
    model = "From-scratch RV32IMA Wishbone SoC";

    chosen {
        /* stdout-path is honored by U-Boot/OpenSBI-style firmware to pick a
         * console; bootargs is what Linux reads as its command line.
         *
         * `earlycon=sbi` prints through OpenSBI's own console driver from
         * the first line of the kernel until the 8250 driver probes, which
         * covers the window this SoC is worst at: no output at all, and no
         * way to tell a kernel that died early from one that never started.
         * It costs nothing - OpenSBI's console is already up by then.
         *
         * Both consoles end up driving the same ns16550. Linux reprograms
         * the divisor when it takes over, and computes it the same way
         * OpenSBI does - (clock + 8*baud) / (16*baud), rounding rather than
         * truncating - so 25 MHz and 115200 give 14 in both cases and the
         * line does not change speed at the handover. A driver that
         * truncated would give 13 and everything after the handover would
         * be garbage rather than silence.
         */
        stdout-path = "serial0:115200n8";
        bootargs = "console=ttyS0,115200 earlycon=sbi";
    };

    aliases {
        serial0 = &uart0;
    };

    cpus {
        #address-cells = <1>;
        #size-cells = <0>;
        /* Must match what rtl/clint.v's mtime actually counts at, which is
         * once per system clock - 25 MHz, the same number as the CPU's
         * clock-frequency below.
         *
         * This said 50000000 until OpenSBI printed
         * "aclint-mtimer @ 50000000Hz" and made it obvious. Everything an SBI
         * implementation does with time is derived from here, so a factor of
         * two wrong is a factor of two wrong in every timer a kernel sets -
         * and it shows up as a system that runs at half speed rather than as
         * an error. */
        timebase-frequency = <25000000>;

        cpu0: cpu@0 {
            device_type = "cpu";
            reg = <0>;
            compatible = "riscv";
            /* M and A are implemented in hardware even though software/ is
             * compiled as rv32im - see software/soc/main.c's note on the
             * missing rv32ima multilib. */
            riscv,isa = "rv32ima_zicsr_zifencei";
            riscv,isa-base = "rv32i";
            riscv,isa-extensions = "i", "m", "a", "zicsr", "zifencei";
            mmu-type = "riscv,sv32";
            clock-frequency = <25000000>;
            status = "okay";

            cpu0_intc: interrupt-controller {
                #interrupt-cells = <1>;
                compatible = "riscv,cpu-intc";
                interrupt-controller;
            };
        };

        /* Phase 13, Stage 10: a second hart, matching rtl/soc/soc_top.v's
         * own NUM_HARTS=2 (simulation only - every real board build still
         * pins NUM_HARTS=1, so this node describes hardware that exists
         * under `make sim_opensbi`/`sim_linux` and nowhere else yet). `reg`
         * is the hart ID clint0/plic0's own interrupts-extended lists below
         * index by position, and rtl/cpu_core.v's own HARTID parameter -
         * all three must agree, the same "nothing checks these match"
         * caution every other duplicated constant in this file already
         * carries. docs/roadmap.md's Phase 13 entry has the full account. */
        cpu1: cpu@1 {
            device_type = "cpu";
            reg = <1>;
            compatible = "riscv";
            riscv,isa = "rv32ima_zicsr_zifencei";
            riscv,isa-base = "rv32i";
            riscv,isa-extensions = "i", "m", "a", "zicsr", "zifencei";
            mmu-type = "riscv,sv32";
            clock-frequency = <25000000>;
            status = "okay";

            cpu1_intc: interrupt-controller {
                #interrupt-cells = <1>;
                compatible = "riscv,cpu-intc";
                interrupt-controller;
            };
        };
    };

    memory@80000000 {
        device_type = "memory";
        /* 64 KB, which is what a board actually has: fpga/ulx3s_top.v passes
         * RAM_BYTES(65536), and software/soc/soc.h's RAM_SIZE says the same.
         *
         * This declared 0x40000 - the 256 KB simulation figure - and was
         * wrong on every board that has ever run this tree. It survived
         * because `arch/riscv` sets phys_ram_base to the kernel's own load
         * address and drops every range below it, so Linux prints
         *
         *     OF: fdt: Ignoring memory block 0x80000000 - 0x80040000
         *
         * and never touches the node. A lie nothing acts on is still a lie,
         * and the next consumer of this file may not be a kernel that
         * discards it - a bare-metal program handed this tree would size its
         * heap from a number four times too big.
         *
         * Kept as a separate node from the SDRAM below rather than merged,
         * because they are separate slaves at separate bases with very
         * different latency, and nothing in this system relocates either.
         *
         * Duplicated in fpga/ulx3s_top.v (RAM_BYTES) and software/soc/soc.h
         * (RAM_SIZE), and nothing checks that the three agree -
         * docs/practices.md section 11. Safe direction of error is *small*:
         * under-declaring wastes memory, over-declaring hands software
         * addresses that read back as garbage. */
        reg = <0x80000000 0x00010000>;
    };

    memory@90000000 {
        device_type = "memory";
        /* The external SDR SDRAM: the whole 32 MB part. This node did not
         * exist while the interconnect decoded addr[31:24] by equality, which
         * capped the slave at 16 MB; the per-slave mask in soc_top.v's
         * `s_mask` is what makes the second half addressable.
         *
         * This size is duplicated in software/soc/soc.h (SDRAM_SIZE), in
         * soc_top.v's s_base/s_mask pair, and in the ORIGIN of
         * software/soc/link_sdram.ld. Nothing checks that the four agree -
         * docs/practices.md section 11. Safe direction of error is *small*:
         * under-declaring wastes memory, while over-declaring hands a kernel
         * addresses that decode to no slave and read back as zeros. */
        reg = <0x90000000 0x02000000>;
    };

    soc {
        #address-cells = <1>;
        #size-cells = <1>;
        compatible = "simple-bus";
        ranges;

        rom@0 {
            compatible = "mtd-rom";
            reg = <0x00000000 0x00004000>;
            read-only;
        };

        clint0: clint@2000000 {
            compatible = "riscv,clint0";
            reg = <0x02000000 0x00010000>;
            /* 3 = machine software interrupt, 7 = machine timer interrupt,
             * one pair per hart, in hart order - the standard aclint-mswi/
             * aclint-mtimer convention, and rtl/clint.v's own
             * NUM_HARTS-indexed msip_out/mtip vectors (Phase 13 stage 2)
             * already match it: hart h's msip is bit h, hart h's mtip is
             * bit h, independently of each other. */
            interrupts-extended = <&cpu0_intc 3 &cpu0_intc 7
                                    &cpu1_intc 3 &cpu1_intc 7>;
        };

        plic0: plic@3000000 {
            compatible = "riscv,plic0";
            /* 4 MB, not 64 KB: the standard register map puts context c's
             * threshold and claim at 0x200000 + 0x1000*c, so a window that
             * stopped at 64 KB would not contain the registers a driver
             * actually uses. rtl/plic.v implements that map; the
             * interconnect gives this slave 16 MB and this declares the part
             * of it that answers. */
            reg = <0x03000000 0x00400000>;
            /* Two contexts per hart, in the order rtl/plic.v numbers them:
             * context 2*h is hart h's M-mode (cause 11, MEI) and 2*h+1 is
             * its S-mode (cause 9, SEI) - matching rtl/soc/soc_top.v's own
             * plic_eip[2*h]/plic_eip[2*h+1] convention (Phase 13 stage 8).
             * The ordering is the interface - a driver derives the context
             * index from position in this list - and nothing checks it
             * against PLIC_CTX_M/PLIC_CTX_S in software/soc/soc.h. Getting
             * it backwards points every driver at the other privilege
             * level's threshold register and fails silently, by never
             * delivering. */
            interrupts-extended = <&cpu0_intc 11 &cpu0_intc 9
                                    &cpu1_intc 11 &cpu1_intc 9>;
            interrupt-controller;
            #interrupt-cells = <1>;
            riscv,ndev = <8>;
        };

        uart0: serial@4000000 {
            /* rtl/uart.v is an 8250-family part with the 16550 register map
             * and **no FIFOs**, so that is what this says: a 16450, which can
             * also be driven as a 16550 with the FIFO left alone. Both
             * entries are true, and the order is what makes the first one
             * count - Linux scores a match by its index in *this* list, so it
             * takes ns16450, and OpenSBI's uart8250 driver matches on ns16550
             * and keeps its console.
             *
             * This said "ns16550a" for one revision, and the single letter
             * cost a whole boot. The comment below used to end "a driver that
             * checks will stay in 16450 mode", and the flaw is in the
             * premise: nothing checks. drivers/tty/serial/8250/8250_of.c sets
             * UPF_FIXED_TYPE, so serial_core skips autoconfig() entirely and
             * the compatible string *is* the configuration - IIR is never
             * read. "ns16550a" means PORT_16550A means tx_loadsz = 16, and
             * serial8250_tx_chars() then writes sixteen bytes into a
             * one-byte holding register after a single THRE, with no status
             * check between them. Fifteen are discarded, in hardware, with
             * nothing to report them: rtl/uart.v's TX_IDLE arm takes a write
             * only when the transmitter is free.
             *
             * The output that produces is thinned rather than absent, so it
             * reads as a console decoding at the wrong rate - a fault in the
             * instrument - and the machine looks like it died where it in
             * fact carried on. `make sim_linux` runs with `+checkuart`, which
             * watches both ends of the wire and names the bytes.
             *
             * This node already carried the right instinct, about the string
             * *before* that one, when rtl/uart.v was three registers of this
             * project's own design: "naming a compatible string you do not
             * implement loads a driver that talks to the wrong registers - a
             * worse failure than having no driver." The registers were right
             * the second time. The buffer depth was not, and nothing in the
             * format distinguishes those two kinds of lie.
             *
             * reg-shift 2 puts register n at offset 4n, which is how this
             * word-addressed bus wants it and what rtl/uart.v decodes.
             *
             * `fifo-size` is absent and IIR reports bits 7:6 = 00, which is
             * how a part without FIFOs identifies itself to anything that
             * does ask.
             */
            compatible = "ns16450", "ns16550";
            reg = <0x04000000 0x00010000>;
            reg-shift = <2>;
            reg-io-width = <4>;
            interrupt-parent = <&plic0>;
            interrupts = <1>;
            clock-frequency = <25000000>;
            current-speed = <115200>;
            status = "okay";
        };

        gpio0: gpio@5000000 {
            compatible = "riscv-fpga-cpu,gpio0";
            reg = <0x05000000 0x00010000>;
            gpio-controller;
            #gpio-cells = <2>;
            ngpios = <16>;
            interrupt-controller;
            #interrupt-cells = <2>;
            interrupt-parent = <&plic0>;
            interrupts = <2>;
            status = "okay";
        };

        spi0: spi@6000000 {
            compatible = "riscv-fpga-cpu,spi0";
            reg = <0x06000000 0x00010000>;
            #address-cells = <1>;
            #size-cells = <0>;
            status = "okay";

            /* The card the boot ROM loads the program image from. */
            mmc@0 {
                compatible = "mmc-spi-slot";
                reg = <0>;
                spi-max-frequency = <25000000>;
                voltage-ranges = <3300 3300>;
            };
        };

        /* Framebuffer (rtl/soc/wb_framebuffer.v).
         *
         * 320x240, 8 bits per pixel, RRRGGGBB direct colour, pixel-doubled
         * to a 640x480 raster on scan-out. `simple-framebuffer` is the
         * generic binding for exactly this - a buffer somebody else has
         * already configured, which the OS only has to draw into.
         *
         * The `format` property has no standard code for RGB332, so this
         * declares the geometry and stride and leaves the format out rather
         * than claiming one that would be wrong. A driver reading this
         * should consult wb_framebuffer.v for the pixel encoding.
         *
         * `status` is "disabled" because this device tree describes the
         * SoC generically and cannot know, at authoring time, whether a
         * given build actually routed the pixel stream to real pins - that
         * is opt-in (`WITH_VIDEO`, `fpga/ulx3s_top.v`) since it costs this
         * board's own timing margin (docs/roadmap.md's Phase 4 entry), not
         * the default. The encoder, PLL and TMDS serializer all exist and
         * are gated in `make verify`; only a real monitor hasn't confirmed
         * it yet. The buffer itself is readable and writable regardless.
         */
        framebuffer0: framebuffer@7000000 {
            compatible = "simple-framebuffer";
            reg = <0x07000000 0x00012C00>;   /* 320 * 240 bytes */
            width = <320>;
            height = <240>;
            stride = <320>;
            status = "disabled";
        };

        /* General-purpose timer / PWM (rtl/soc/wb_timer.v). One channel -
         * docs/roadmap.md's Phase 12 entry has the reasoning. No real
         * kernel driver binds "riscv-fpga-cpu,timer0", matching gpio0/
         * spi0's own custom compatible strings above - these nodes are
         * informational, not yet a live Linux capability.
         */
        timer0: timer@8000000 {
            compatible = "riscv-fpga-cpu,timer0";
            reg = <0x08000000 0x00010000>;
            interrupt-parent = <&plic0>;
            interrupts = <3>;
            status = "okay";
        };
    };
};
