/dts-v1/;

/*
 * Device tree for the SoC in rtl/soc/soc_top.v.
 *
 * Build it with `make dtb`, which compiles it and then round-trips the
 * result back to source to confirm it decodes.
 *
 * What this is and isn't: it is an accurate description of the hardware in
 * the standard format that RISC-V firmware (OpenSBI, U-Boot, Linux) expects
 * to be handed. It is *not* consumed by anything in this project today - the
 * boot ROM and the RAM program both have the memory map compiled in via
 * software/soc/soc.h. It exists because a device tree is the interface any
 * real system software would come looking for, and writing it now is what
 * makes the address map explicit and reviewable in one place.
 *
 * Anything here that would need to change before real supervisor software
 * could use it is called out in a comment rather than quietly fudged.
 *
 * Frequencies are 25 MHz, which is what the ULX3S build actually runs at
 * (soc_top.v's CLK_HZ, and fpga/README.md's measured Fmax of 25.37 MHz gives
 * it 1.5% of margin). They used to say 50 MHz, which was a placeholder from
 * before the design had ever been on a board.
 *
 * `timebase-frequency` must match what the CLINT's mtime actually counts at,
 * and in this design mtime increments once per *system clock* (rtl/clint.v, a
 * documented simplification versus a real separate always-on reference
 * clock), so the two are the same number here.
 *
 * The UART's `clock-frequency` is the input to its baud divisor, and 25 MHz
 * does not divide evenly to 115200: a driver computing 25e6/(16*115200) gets
 * 13.56 and will write 14, for 111607 baud - 3.1% slow. That is inside the
 * roughly 5% a UART frame tolerates, but it is a real error rather than zero,
 * and it is the kind of thing that shows up as occasional framing errors on a
 * long cable rather than as an obvious failure.
 */

/ {
    #address-cells = <1>;
    #size-cells = <1>;
    compatible = "riscv-fpga-cpu,soc";
    model = "From-scratch RV32IMA Wishbone SoC";

    chosen {
        /* No bootargs: there is no kernel to pass them to yet. stdout-path
         * is honored by U-Boot/OpenSBI-style firmware to pick a console. */
        stdout-path = "serial0:115200n8";
    };

    aliases {
        serial0 = &uart0;
    };

    cpus {
        #address-cells = <1>;
        #size-cells = <0>;
        timebase-frequency = <50000000>;

        cpu0: cpu@0 {
            device_type = "cpu";
            reg = <0>;
            compatible = "riscv";
            /* M and A are implemented in hardware even though software/ is
             * compiled as rv32im - see software/soc/main.c's note on the
             * missing rv32ima multilib. */
            riscv,isa = "rv32ima_zicsr_zifencei";
            riscv,isa-base = "rv32i";
            riscv,isa-extensions = "i", "m", "a", "zicsr", "zifencei";
            mmu-type = "riscv,sv32";
            clock-frequency = <25000000>;
            status = "okay";

            cpu0_intc: interrupt-controller {
                #interrupt-cells = <1>;
                compatible = "riscv,cpu-intc";
                interrupt-controller;
            };
        };
    };

    memory@80000000 {
        device_type = "memory";
        /* 256 KB of on-chip block RAM - the simulation figure; a board build
         * has 64 KB (see software/soc/soc.h's RAM_SIZE for why). Kept as a
         * separate node from the SDRAM below rather than merged, because they
         * are separate slaves at separate bases with very different latency,
         * and nothing in this system relocates either of them. */
        reg = <0x80000000 0x00040000>;
    };

    memory@90000000 {
        device_type = "memory";
        /* The external SDR SDRAM: the whole 32 MB part. This node did not
         * exist while the interconnect decoded addr[31:24] by equality, which
         * capped the slave at 16 MB; the per-slave mask in soc_top.v's
         * `s_mask` is what makes the second half addressable.
         *
         * This size is duplicated in software/soc/soc.h (SDRAM_SIZE), in
         * soc_top.v's s_base/s_mask pair, and in the ORIGIN of
         * software/soc/link_sdram.ld. Nothing checks that the four agree -
         * docs/practices.md section 11. Safe direction of error is *small*:
         * under-declaring wastes memory, while over-declaring hands a kernel
         * addresses that decode to no slave and read back as zeros. */
        reg = <0x90000000 0x02000000>;
    };

    soc {
        #address-cells = <1>;
        #size-cells = <1>;
        compatible = "simple-bus";
        ranges;

        rom@0 {
            compatible = "mtd-rom";
            reg = <0x00000000 0x00004000>;
            read-only;
        };

        clint0: clint@2000000 {
            compatible = "riscv,clint0";
            reg = <0x02000000 0x00010000>;
            /* 3 = machine software interrupt, 7 = machine timer interrupt */
            interrupts-extended = <&cpu0_intc 3 &cpu0_intc 7>;
        };

        plic0: plic@3000000 {
            compatible = "riscv,plic0";
            /* 4 MB, not 64 KB: the standard register map puts context c's
             * threshold and claim at 0x200000 + 0x1000*c, so a window that
             * stopped at 64 KB would not contain the registers a driver
             * actually uses. rtl/plic.v implements that map; the
             * interconnect gives this slave 16 MB and this declares the part
             * of it that answers. */
            reg = <0x03000000 0x00400000>;
            /* Two contexts, in the order rtl/plic.v numbers them: context 0
             * is this hart's M-mode (cause 11, MEI) and context 1 is its
             * S-mode (cause 9, SEI). The ordering is the interface - a driver
             * derives the context index from position in this list - and
             * nothing checks it against PLIC_CTX_M/PLIC_CTX_S in
             * software/soc/soc.h. Getting it backwards points every driver at
             * the other privilege level's threshold register and fails
             * silently, by never delivering. */
            interrupts-extended = <&cpu0_intc 11 &cpu0_intc 9>;
            interrupt-controller;
            #interrupt-cells = <1>;
            riscv,ndev = <8>;
        };

        uart0: serial@4000000 {
            /* This claim used to be a lie and is now true: rtl/uart.v is an
             * ns16550. It was three registers of this project's own design,
             * and the comment here said so, because naming a compatible
             * string you do not implement loads a driver that talks to the
             * wrong registers - a worse failure than having no driver.
             *
             * reg-shift 2 puts register n at offset 4n, which is how this
             * word-addressed bus wants it and what rtl/uart.v decodes.
             *
             * No FIFOs: `fifo-size` is deliberately absent and IIR reports
             * bits 7:6 = 00, so a driver that checks will stay in 16450 mode.
             */
            compatible = "ns16550a";
            reg = <0x04000000 0x00010000>;
            reg-shift = <2>;
            reg-io-width = <4>;
            interrupt-parent = <&plic0>;
            interrupts = <1>;
            clock-frequency = <25000000>;
            current-speed = <115200>;
            status = "okay";
        };

        gpio0: gpio@5000000 {
            compatible = "riscv-fpga-cpu,gpio0";
            reg = <0x05000000 0x00010000>;
            gpio-controller;
            #gpio-cells = <2>;
            ngpios = <16>;
            interrupt-controller;
            #interrupt-cells = <2>;
            interrupt-parent = <&plic0>;
            interrupts = <2>;
            status = "okay";
        };

        spi0: spi@6000000 {
            compatible = "riscv-fpga-cpu,spi0";
            reg = <0x06000000 0x00010000>;
            #address-cells = <1>;
            #size-cells = <0>;
            status = "okay";

            /* The card the boot ROM loads the program image from. */
            mmc@0 {
                compatible = "mmc-spi-slot";
                reg = <0>;
                spi-max-frequency = <25000000>;
                voltage-ranges = <3300 3300>;
            };
        };

        /* Framebuffer (rtl/soc/wb_framebuffer.v).
         *
         * 320x240, 8 bits per pixel, RRRGGGBB direct colour, pixel-doubled
         * to a 640x480 raster on scan-out. `simple-framebuffer` is the
         * generic binding for exactly this - a buffer somebody else has
         * already configured, which the OS only has to draw into.
         *
         * The `format` property has no standard code for RGB332, so this
         * declares the geometry and stride and leaves the format out rather
         * than claiming one that would be wrong. A driver reading this
         * should consult wb_framebuffer.v for the pixel encoding.
         *
         * `status` is "disabled" because nothing drives a display yet: the
         * pixel stream leaves soc_fpga.v unconnected pending a PLL and a
         * TMDS serializer. The buffer itself is readable and writable now.
         */
        framebuffer0: framebuffer@7000000 {
            compatible = "simple-framebuffer";
            reg = <0x07000000 0x00012C00>;   /* 320 * 240 bytes */
            width = <320>;
            height = <240>;
            stride = <320>;
            status = "disabled";
        };
    };
};
