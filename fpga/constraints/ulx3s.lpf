## ULX3S (Radiona/emard) - LFE5U-45F, CABGA381, board revision v2.0 / v3.0
##
## Real pins, unlike constraints/generic.lpf. Taken from the official
## ulx3s_v20.lpf and cross-checked against litex-boards' radiona_ulx3s.py,
## which agree on all four SPI-mode SD pins.
##
## !! NOT VALID FOR ULX3S v1.7 !!  That revision wires the SD card's four
## SPI-mode pins to entirely different sites (sck=J1, mosi=J3, miso=K2,
## cs_n=H1). A v1.7 board will build and load with this file and then fail to
## find the card. Check the silkscreen.
##
## Used by:  LPF=fpga/constraints/ulx3s.lpf TOP=ulx3s_top ./fpga/synth/synth_ecp5.sh
##
## Unlike constraints/timing_only.lpf, this constrains the I/O as well as the
## clock, so the Fmax it produces is the honest one for this board rather than
## a number from a build where nextpnr could place pins wherever it liked.

## ---- clock ----
LOCATE COMP "clk_25mhz" SITE "G2";
IOBUF  PORT "clk_25mhz" PULLMODE=NONE IO_TYPE=LVCMOS33;
FREQUENCY PORT "clk_25mhz" 25 MHZ;

## ---- FTDI FT231X serial console ----
## Named from the FTDI's point of view: ftdi_rxd is an FPGA output.
LOCATE COMP "ftdi_rxd" SITE "L4";
LOCATE COMP "ftdi_txd" SITE "M1";
IOBUF  PORT "ftdi_rxd" PULLMODE=UP IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF  PORT "ftdi_txd" PULLMODE=UP IO_TYPE=LVCMOS33;

## ---- microSD, used in SPI mode ----
## sd_d[0] is MISO and sd_d[3] is chip select; sd_d[2:1] are unused in SPI
## mode but are driven high by ulx3s_top.v rather than left to float.
LOCATE COMP "sd_clk"  SITE "H2";
LOCATE COMP "sd_cmd"  SITE "J1";
LOCATE COMP "sd_d[0]" SITE "J3";
LOCATE COMP "sd_d[1]" SITE "H1";
LOCATE COMP "sd_d[2]" SITE "K1";
LOCATE COMP "sd_d[3]" SITE "K2";
LOCATE COMP "sd_cdn"  SITE "N5";
IOBUF  PORT "sd_clk"  PULLMODE=UP IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF  PORT "sd_cmd"  PULLMODE=UP IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF  PORT "sd_d[0]" PULLMODE=UP IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF  PORT "sd_d[1]" PULLMODE=UP IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF  PORT "sd_d[2]" PULLMODE=UP IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF  PORT "sd_d[3]" PULLMODE=UP IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF  PORT "sd_cdn"  PULLMODE=UP IO_TYPE=LVCMOS33;

## ---- buttons ----
## btn[0] is the power button (pulled up); btn[1..6] are pulled down and so
## read high while pressed. ulx3s_top.v uses btn[1] as an active-low reset.
LOCATE COMP "btn[0]" SITE "D6";
LOCATE COMP "btn[1]" SITE "R1";
LOCATE COMP "btn[2]" SITE "T1";
LOCATE COMP "btn[3]" SITE "R18";
LOCATE COMP "btn[4]" SITE "V1";
LOCATE COMP "btn[5]" SITE "U1";
LOCATE COMP "btn[6]" SITE "H16";
IOBUF  PORT "btn[0]" PULLMODE=UP   IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF  PORT "btn[1]" PULLMODE=DOWN IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF  PORT "btn[2]" PULLMODE=DOWN IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF  PORT "btn[3]" PULLMODE=DOWN IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF  PORT "btn[4]" PULLMODE=DOWN IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF  PORT "btn[5]" PULLMODE=DOWN IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF  PORT "btn[6]" PULLMODE=DOWN IO_TYPE=LVCMOS33 DRIVE=4;

## ---- LEDs ----
## led[3:0] carry soc_fpga.v's status: trap, heartbeat, and the two-bit boot
## stage. led[7:4] are parked low.
LOCATE COMP "led[0]" SITE "B2";
LOCATE COMP "led[1]" SITE "C2";
LOCATE COMP "led[2]" SITE "C1";
LOCATE COMP "led[3]" SITE "D2";
LOCATE COMP "led[4]" SITE "D1";
LOCATE COMP "led[5]" SITE "E2";
LOCATE COMP "led[6]" SITE "E1";
LOCATE COMP "led[7]" SITE "H3";
IOBUF  PORT "led[0]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF  PORT "led[1]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF  PORT "led[2]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF  PORT "led[3]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF  PORT "led[4]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF  PORT "led[5]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF  PORT "led[6]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF  PORT "led[7]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;

## ---- ESP32 boot-mode hold-off ----
## Driven high by ulx3s_top.v. Not optional - see the comment there.
LOCATE COMP "wifi_gpio0" SITE "L2";
IOBUF  PORT "wifi_gpio0" PULLMODE=UP IO_TYPE=LVCMOS33 DRIVE=4;

## ---- general-purpose header, carrying the SoC's 16 GPIO ----
## gpio[13:0] -> gp[13:0], gpio[15:14] -> gn[1:0]. The rest of gn is
## constrained so the pins are claimed rather than left for nextpnr to assign.
LOCATE COMP "gp[0]"  SITE "B11";
LOCATE COMP "gp[1]"  SITE "A10";
LOCATE COMP "gp[2]"  SITE "A9";
LOCATE COMP "gp[3]"  SITE "B9";
LOCATE COMP "gp[4]"  SITE "A7";
LOCATE COMP "gp[5]"  SITE "C8";
LOCATE COMP "gp[6]"  SITE "C6";
LOCATE COMP "gp[7]"  SITE "A6";
LOCATE COMP "gp[8]"  SITE "A4";
LOCATE COMP "gp[9]"  SITE "A2";
LOCATE COMP "gp[10]" SITE "C4";
LOCATE COMP "gp[11]" SITE "F4";
LOCATE COMP "gp[12]" SITE "G3";
LOCATE COMP "gp[13]" SITE "H4";
LOCATE COMP "gn[0]"  SITE "C11";
LOCATE COMP "gn[1]"  SITE "A11";
LOCATE COMP "gn[2]"  SITE "B10";
LOCATE COMP "gn[3]"  SITE "C10";
LOCATE COMP "gn[4]"  SITE "A8";
LOCATE COMP "gn[5]"  SITE "B8";
LOCATE COMP "gn[6]"  SITE "C7";
LOCATE COMP "gn[7]"  SITE "B6";
LOCATE COMP "gn[8]"  SITE "A5";
LOCATE COMP "gn[9]"  SITE "B1";
LOCATE COMP "gn[10]" SITE "B4";
LOCATE COMP "gn[11]" SITE "E3";
LOCATE COMP "gn[12]" SITE "F3";
LOCATE COMP "gn[13]" SITE "G5";
IOBUF PORT "gp[0]"  PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "gp[1]"  PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "gp[2]"  PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "gp[3]"  PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "gp[4]"  PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "gp[5]"  PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "gp[6]"  PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "gp[7]"  PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "gp[8]"  PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "gp[9]"  PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "gp[10]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "gp[11]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "gp[12]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "gp[13]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "gn[0]"  PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "gn[1]"  PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "gn[2]"  PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "gn[3]"  PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "gn[4]"  PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "gn[5]"  PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "gn[6]"  PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "gn[7]"  PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "gn[8]"  PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "gn[9]"  PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "gn[10]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "gn[11]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "gn[12]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "gn[13]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
